[mysqld]
# secure-file-priv = '/var/lib/mysql-files/'

# create dabatase
character-set-server=utf8mb4
collation-server=utf8mb4_unicode_ci
# mysql_native_password is disabled by default in MySQL 8.4, and
# default_authentication_plugin was removed. Enable the plugin explicitly.
mysql_native_password=ON

[client]
default-character-set=utf8mb4
